// Cloudflare Workers config.
// One-time setup before the first deploy:
//   npx wrangler r2 bucket create iany-models
{
  "name": "iany",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Model mirror, API, and Radio requests must reach the worker; everything
    // else (including the standalone /voice page → voice.html) is served
    // directly as static assets. The voice API lives under /api/voice/*,
    // already covered by /api/*.
    "run_worker_first": ["/models/*", "/api/*", "/hf-api/*", "/radio/*", "/download/*"]
  },
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "iany-models"
    }
  ],
  // iAny Radio news store. Apply the schema once:
  //   npx wrangler d1 execute iany-radio --remote --file worker/schema.sql
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iany-radio",
      "database_id": "3fd21875-1ed5-438c-b249-83baa9f2ab2c"
    }
  ],
  // Workers AI — powers POST /api/decide (typesafe/jev structured decisions).
  // Optional: with no binding the Decide page answers entirely on-device.
  "ai": {
    "binding": "AI"
  },
  // Shared answer cache for /api/decide. Because the cache key is built from
  // bucketed enums, different people in the same situation share a key, so one
  // miss warms the answer for everyone. Entries expire after 24h (see
  // worker/decide.ts CACHE_TTL_SECONDS). Created with:
  //   npx wrangler kv namespace create DECIDE_CACHE
  "kv_namespaces": [
    {
      "binding": "DECIDE_CACHE",
      "id": "e62d7953ae5f46e79508af20eabfd5f4"
    }
  ],
  // Daily purge of news past its 7-day TTL (worker `scheduled` handler).
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
